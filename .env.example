# Copy to .env.local and fill in. Never commit real values.
# .env.local로 복사해서 채워 넣으세요. 실제 값은 절대 커밋하지 않습니다.

# Supabase — local: `npx -y supabase@2.122.0 status` shows these (API URL, anon key)
# 로컬은 위 명령의 API URL / anon key, 운영은 Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public token (pk.*) — https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: canonical site URL for metadata/OG (defaults to the Vercel URL)
# NEXT_PUBLIC_SITE_URL=
